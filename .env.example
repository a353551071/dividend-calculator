# Copy this file to `.env.local` and fill in the values you have.
# Every variable is OPTIONAL — the site builds and runs fine with none of them set;
# an unset variable simply disables that integration.

# Google AdSense publisher id, e.g. ca-pub-1234567890123456 (set AFTER AdSense approval).
# Gates the adsbygoogle script and the <AdBanner> slots.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4 measurement id, e.g. G-ABCDE12345 (gates the gtag snippet).
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project id (gates the Clarity heatmap/session-replay snippet).
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console verification token (emits <meta name="google-site-verification">).
NEXT_PUBLIC_GSC_VERIFICATION=
